# Application
PORT=3000
NODE_ENV=development

# Database (development — docker-compose service `postgres`, host port 5436)
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/ubma_ceil_db

# Test database only (`postgres_test` service, host port 5437). Copy to `.env.test` for e2e.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5437/ubma_ceil_test

# Auth
JWT_SECRET=supersecret

# Email notifications
# Set to true to enable any form of email dispatch (console or real)
NOTIFICATIONS_EMAIL_ENABLED=false
# Supported providers: resend | console
EMAIL_PROVIDER=console
# The sender email address. 
# IMPORTANT: If using Resend, this domain MUST be verified in the Resend dashboard.
# Gmail/Public domains will fail in production.
EMAIL_FROM="CEIL UBMA <noreply@ceil-annaba.dz>"

# Resend Configuration
# Required only if EMAIL_PROVIDER=resend
RESEND_API_KEY=
# E2E / Jest sets NODE_ENV=test. Emails are NOT sent unless you set:
# RESEND_ALLOW_IN_E2E=true
# and provide RESEND_API_KEY + EMAIL_FROM (use only when you intend real test sends)
RESEND_ALLOW_IN_E2E=false

# Optional default inbox for enrollment alerts when the caller does not pass one
ADMIN_NOTIFICATION_EMAIL=admin@ubma.dz

# Payments (Chargily Pay v2). Keep PAYMENTS_ENABLED=false until keys and webhook URL are ready.
PAYMENTS_ENABLED=false

CHARGILY_MODE=test
CHARGILY_TEST_SECRET_KEY=
CHARGILY_LIVE_SECRET_KEY=

CHARGILY_TEST_BASE_URL=https://pay.chargily.net/test/api/v2
CHARGILY_LIVE_BASE_URL=https://pay.chargily.net/api/v2

CHARGILY_WEBHOOK_SECRET=
CHARGILY_WEBHOOK_SIGNATURE_HEADER=signature

APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000/api/v1

PAYMENT_SUCCESS_PATH=/payment/success
PAYMENT_FAILURE_PATH=/payment/failure

PAYMENT_CHECKOUT_LOCALE=fr
PAYMENT_METHOD=edahabia
PAYMENT_FEES_ALLOCATION=customer
